# --- Vibe Coder safety patterns (Issue #1751) ---
.*
!.gitignore
!.github
!.vscode
!.markdownlint-cli2.jsonc
!.gitattributes
.config.json
.config*.json
*.secret.json
.secrets/
.env
.env.*
*.pem
*.key
*.p12
*.pfx
id_rsa
id_rsa.*
credentials.json
service-account*.json
/graft/
/.codegraph/
# --- end Vibe Coder safety patterns ---

# Cargo's per-repository config (host-local rustflags) is the one other hidden
# path this repository commits.
!.cargo/
!.cargo/config.toml

# Generated by Cargo.
/target/
**/*.rs.bk

# MSVC Windows builds of rustc generate these.
*.pdb

# cargo-mutants output.
**/mutants.out*/

# SBOM output from `cargo cyclonedx` (CI uploads it as an artefact).
*.cdx.json

*~
.DS_Store
