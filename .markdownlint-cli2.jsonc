// markdownlint-cli2 configuration — shared by CI (`markdown-lint.yml`) and
// `./quality.sh`. Rules not listed here keep their defaults.
{
  "config": {
    "default": true,
    // Prose is wrapped by hand; long URLs and tables cannot be.
    "MD013": false,
    // Repeated headings are fine under different parents.
    "MD024": { "siblings_only": true }
  },
  "globs": ["**/*.md"],
  "ignores": ["target/**", "docs/archive/**"]
}
